[Unit]
Description=Dockhand Modern Docker Management UI
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/dockhand/dockhand.sh start
ExecStop=/opt/dockhand/dockhand.sh stop
ExecReload=/opt/dockhand/dockhand.sh status
RemainAfterExit=true
User=dockhand
Group=dockhand
TimeoutStartSec=60
TimeoutStopSec=30
Restart=on-failure

[Install]
WantedBy=multi-user.target
