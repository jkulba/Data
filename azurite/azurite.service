[Unit]
Description=Azurite Storage Emulator Container
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/azurite/azurite.sh start
ExecStop=/opt/azurite/azurite.sh stop
ExecReload=/opt/azurite/azurite.sh status
RemainAfterExit=true
User=azurite
Group=azurite
TimeoutStartSec=60
TimeoutStopSec=30
Restart=on-failure

[Install]
WantedBy=multi-user.target
